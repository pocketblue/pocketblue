[copr:copr.fedorainfracloud.org:group_mobility:common]
name=Copr repo for common owned by @mobility
baseurl=https://download.copr.fedorainfracloud.org/results/@mobility/common/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=True
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/@mobility/common/pubkey.gpg
repo_gpgcheck=0
enabled=0
enabled_metadata=1
priority=95
