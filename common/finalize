#!/usr/bin/env bash

set -uexo pipefail

sed -i "s/^PRETTY_NAME=.*/PRETTY_NAME=\"Fedora Linux ${target_tag} (${desktop})\"/" /usr/lib/os-release

if [ -f /usr/lib/systemd/ukify.conf ]; then
  cd /usr/lib/modules/*
  ukify build \
    --linux=vmlinuz \
    --uname=$(basename /usr/lib/modules/*) \
    --output=uki.efi
  mv uki.efi vmlinuz
fi

dnf5 clean all

find /var/* -maxdepth 0 -type d \! -name cache -exec rm -fr {} \;

mkdir -p /var/tmp
chmod -R 1777 /var/tmp
